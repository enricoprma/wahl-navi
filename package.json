{
  "name": "wahl-navi",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prestart": "npm run data:export",
    "start": "ng serve",
    "data:export": "node scripts/run-importer.mjs",
    "data:check": "node scripts/run-importer.mjs --check",
    "prebuild": "npm run data:export",
    "build": "ng build --configuration production",
    "prewatch": "npm run data:export",
    "watch": "ng build --watch --configuration development",
    "test:data": "node scripts/run-python-tests.mjs",
    "test": "ng test --watch=false --browsers=ChromeHeadlessNoGpu",
    "lint": "eslint src --max-warnings=0",
    "format": "prettier --write \"{src,tools,scripts,.github}/**/*.{ts,html,js,mjs,json,yml,yaml}\" \"*.{json,js,mjs,yml,yaml}\"",
    "format:check": "prettier --check \"{src,tools,scripts,.github}/**/*.{ts,html,js,mjs,json,yml,yaml}\" \"*.{json,js,mjs,yml,yaml}\"",
    "check": "npm run test:data && npm run data:check && npm run format:check && npm run lint && npm test && npm run build"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.3.31",
    "@angular/compiler": "^20.3.31",
    "@angular/core": "^20.3.31",
    "@angular/forms": "^20.3.31",
    "@angular/material": "^20.2.14",
    "@angular/platform-browser": "^20.3.31",
    "@angular/platform-browser-dynamic": "^20.3.31",
    "@angular/router": "^20.3.31",
    "bootstrap": "^5.3.6",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "yaml": "^2.8.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.37",
    "@angular/cli": "^20.3.37",
    "@angular/compiler-cli": "^20.3.31",
    "@eslint/js": "^9.39.1",
    "@types/jasmine": "~5.1.0",
    "angular-eslint": "^19.8.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "prettier": "^3.9.7",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
